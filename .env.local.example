NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
CCO_SESSION_SECRET=
CCO_INVITE_CODE=
CCO_HOME_URL=https://contentco-op.com
BLAZE_API_URL=
DEER_API_BASE_URL=
DEER_HEALTH_URL=
ALLOW_PRIVATE_RUNTIME_TARGETS=false
CCO_COCUT_URL=https://co-cut.contentco-op.com
CCO_COSCRIPT_URL=https://co-script.contentco-op.com
CCO_CODELIVER_URL=https://co-deliver.contentco-op.com
OPENAI_API_KEY=
YOUTUBE_API_KEY=
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR_ID=
ORCHESTRATOR_PORT=4300

# --- Content Co-Op public intake (/brief) ---
# CCO-DB binding (must resolve to briokwdoonawhxisbydy.supabase.co)
CCO_SUPABASE_URL=
CCO_SUPABASE_SERVICE_ROLE_KEY=
# Outbound email: set RESEND_API_KEY (blaze@contentco-op.com verified in Resend)
# OR a Gmail credential file readable by the runtime user. Without either,
# intake emails log as failed in notification_log.
RESEND_API_KEY=
GOOGLE_OAUTH_TOKEN_FILE_BLAZE=
GOOGLE_DWD_SERVICE_ACCOUNT_FILE=
# Additive operator alert roster (bailey@contentco-op.com is always included)
CCO_ADMIN_ALERT_EMAILS=
# AI proposal generation; unset = deterministic mock proposal is stored
GEMINI_API_KEY=

# Client links: runtime-owned regular file, mode 0600. First key signs; all keys verify.
CCO_CLIENT_LINK_KEY_FILE=/absolute/runtime-home/.config/blaze-secrets/cco-website/client-link.key
# Rotate yearly or on suspected leak: policy only; actual rotation requires Bailey approval.
