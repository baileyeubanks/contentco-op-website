{
  "name": "@contentco-op/home",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "prestart": "node scripts/verify-runtime-env.mjs && node scripts/verify-critical-media.mjs && node scripts/verify-chat-widget-source.mjs",
    "prebuild": "node scripts/verify-runtime-env.mjs --phase=build && node scripts/verify-critical-media.mjs --phase=build && node scripts/verify-chat-widget-source.mjs",
    "dev": "node ../../node_modules/next/dist/bin/next dev -p 4100",
    "build": "node ../../node_modules/next/dist/bin/next build --webpack",
    "postbuild": "cp -R .next/static .next/standalone/apps/home/.next/static 2>/dev/null || true",
    "start": "HOSTNAME=${HOSTNAME:-0.0.0.0} PORT=${PORT:-4100} node scripts/start-standalone-runtime.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "audit:public": "node scripts/audit-public-runtime.mjs",
    "publish:m4": "node scripts/publish-m4-runtime.mjs",
    "export:system-map": "tsx scripts/export-system-map.ts",
    "capture:root-ui": "node scripts/capture-root-ui.mjs",
    "install:canonical-runtime": "bash scripts/install-canonical-runtime-launchd.sh",
    "audit:canonical-runtime": "node scripts/audit-canonical-runtime.mjs",
    "prove:canonical-runtime": "node scripts/prove-canonical-runtime.mjs",
    "recover:canonical-runtime": "bash scripts/recover-canonical-runtime.sh",
    "status:canonical-runtime": "bash scripts/status-canonical-runtime.sh",
    "doctor:canonical-runtime": "bash scripts/status-canonical-runtime.sh --strict"
  },
  "dependencies": {
    "@contentco-op/brand": "0.1.0",
    "@contentco-op/identity-access": "0.1.0",
    "@contentco-op/types": "0.1.0",
    "@contentco-op/ui": "0.1.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google/genai": "^1.51.0",
    "@gsap/react": "^2.1.2",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.10.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.10.2",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.10.0",
    "googleapis": "^171.4.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.23",
    "next": "^16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "schema-dts": "^2.0.0",
    "stripe": "^20.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
